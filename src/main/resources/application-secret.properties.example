# application-secret.properties 템플릿
# 이 파일을 복사해서 application-secret.properties 를 만들고
# 실제 값을 입력하세요.
# ════════════════════════════════════════════════

# JWT Secret
jwt.secret=YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS

# OpenAI API Key (OpenAI 사용 시 주석 해제 후 키 입력)
# spring.ai.openai.api-key=YOUR_OPENAI_API_KEY
